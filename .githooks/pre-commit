#!/bin/sh
# Preflight: VERSION sync + npm ci when frontend package files are staged.
set -e

STAGED=$(git diff --cached --name-only)

version_mismatch() {
  ROOT=$(git rev-parse --show-toplevel)
  VERSION=$(tr -d '\r\n' < "$ROOT/VERSION")
  PKG_VERSION=$(node -p "require('$ROOT/frontend/package.json').version" 2>/dev/null || echo "")
  if [ -z "$PKG_VERSION" ]; then
    echo "pre-commit: could not read frontend/package.json version" >&2
    exit 1
  fi
  if [ "$VERSION" != "$PKG_VERSION" ]; then
    echo "pre-commit: VERSION ($VERSION) != frontend/package.json ($PKG_VERSION)" >&2
    echo "  Bump both together (ADR-006). See .cursor/skills/release-preflight/SKILL.md" >&2
    exit 1
  fi
}

# Sync check when version files are part of this commit
if echo "$STAGED" | grep -qE '^(VERSION|frontend/package\.json)$'; then
  version_mismatch
fi

# npm ci when package manifest or lockfile is staged
if echo "$STAGED" | grep -qE '^frontend/package(-lock)?\.json$'; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "pre-commit: npm not found; skip lockfile check" >&2
    exit 0
  fi
  echo "pre-commit: running npm ci in frontend/ ..."
  (cd "$(git rev-parse --show-toplevel)/frontend" && npm ci --ignore-scripts) || {
    echo "pre-commit: npm ci failed — lockfile out of sync with package.json" >&2
    echo "  On WSL: scripts/sync-frontend-lockfile-docker.sh" >&2
    exit 1
  }
fi

exit 0
