# Copy to .env for local development (never commit .env)

# JWT signing (required before auth endpoints work)
SECRET_KEY=dev-only-change-me-not-for-production

# Access token lifetime in minutes (default 60 if omitted)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Alembic seed for bootstrap admin user (required for `alembic upgrade head`)
INITIAL_ADMIN_PASSWORD=change-me-local-only

# Optional: mark production so missing SECRET_KEY or non-Postgres DATABASE_URL fails at startup
# ENVIRONMENT=production

# Database (optional override)
# DATABASE_URL=sqlite:///./notes.db

# Preview on Render with Neon (Phase 3): use the connection string from Neon dashboard.
# Include sslmode=require if not already in the URL, e.g.:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
